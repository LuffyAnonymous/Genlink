# --- Core ---
SECRET_KEY=replace-with-a-long-random-string
# In production, set this to your real domain (used to build links in emails):
# APP_BASE_URL=https://www.genlinklab.com
APP_BASE_URL=http://localhost:3001
FLASK_DEBUG=false

# --- PostgreSQL ---
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://genlinklab_user:password@localhost:5432/genlinklab

# --- Outgoing email (used to send the registration-confirmation email to admin
# and the welcome email to the customer). Any SMTP provider works - these
# defaults are for AWS WorkMail, change if you use Gmail, Office 365, SES, etc. ---
MAIL_SERVER=smtp.mail.us-east-1.awsapps.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=admin@genlinklab.co.uk
MAIL_PASSWORD=replace-with-mailbox-password
MAIL_DEFAULT_SENDER="Genlinklab <admin@genlinklab.co.uk>"
MAIL_SUPPRESS_SEND=false
ADMIN_EMAIL=admin@genlinklab.co.uk

# --- Bank transfer (manual) ---
# Shown to customers on the buy-credits page; credits are added manually once
# an admin confirms the transfer (via the emailed confirm link) has arrived.
BANK_ACCOUNT_NUMBER=1025818601203
BANK_IBAN=AE600260001025818601203
BANK_CURRENCY=GBP
BANK_BIC_SWIFT=EBILAEADXXX

# --- Your link generation API ---
# The endpoint the app calls to generate a ticket link once a customer spends a credit.
# If it runs on the same server (e.g. LinkGeni.py on port 4000), keep this pointed at
# 127.0.0.1 rather than the public domain - it doesn't need to be internet-reachable.
LINKGEN_API_URL=http://127.0.0.1:4000/api/manutd
LINKGEN_API_KEY=replace-with-your-api-key
LINKGEN_COST_CREDITS=1
