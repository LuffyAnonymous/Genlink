# --- Core ---
SECRET_KEY=replace-with-a-long-random-string
# In production, set this to your real domain (used to build links in emails):
# APP_BASE_URL=https://www.genlinklab.com
APP_BASE_URL=http://localhost:3001
FLASK_DEBUG=false
# Defaults to true (cookies only sent over HTTPS) - only set this false for
# local http:// development, never in production.
SESSION_COOKIE_SECURE=true

# --- PostgreSQL ---
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://genlinklab_user:password@localhost:5432/genlinklab

# --- Outgoing email (registration-confirmation email to admin + welcome
# email to the customer). Sent via Resend's HTTP API (resend.com), not
# SMTP - most PaaS hosts (Render included) block outbound SMTP entirely,
# which no SMTP port/credential change can work around. Get a key from
# Resend's dashboard; verify your sending domain there for real deploys
# (their sandbox sender works immediately for testing, before that's done).
RESEND_API_KEY=replace-with-your-resend-api-key
MAIL_DEFAULT_SENDER="Genlinklab <admin@genlinklab.co.uk>"
MAIL_SUPPRESS_SEND=false
ADMIN_EMAIL=admin@genlinklab.co.uk

# --- Stripe (credit/unlimited-pass checkout) ---
# Test-mode keys from Stripe Dashboard -> Developers -> API keys (make sure
# "Test mode" is on, top right). STRIPE_WEBHOOK_SECRET comes from running
# `stripe listen --forward-to localhost:3001/credits/webhook/stripe`
# locally, or from the webhook's settings in the Stripe Dashboard once a
# real endpoint is registered for production.
STRIPE_SECRET_KEY=sk_test_replace-with-your-key
STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-secret

# --- Your link generation API ---
# The endpoint the app calls to generate a ticket link once a customer spends a credit.
# If it runs on the same server (e.g. LinkGeni.py on port 4000), keep this pointed at
# 127.0.0.1 rather than the public domain - it doesn't need to be internet-reachable.
LINKGEN_API_URL=http://127.0.0.1:4000/api/manutd
LINKGEN_API_KEY=replace-with-your-api-key
LINKGEN_COST_CREDITS=1

# Other clubs can each run their own independent automation service - set
# LINKGEN_API_URL_<SLUG> / LINKGEN_API_KEY_<SLUG> (slug uppercased, hyphens
# to underscores - see app/clubs.py for exact slugs) and the app routes
# that club's requests there automatically, no code changes needed. Falls
# back to LINKGEN_API_URL/KEY above when a club has no override. See
# CONTRIBUTING.md for the full contract.
# LINKGEN_API_URL_LIVERPOOL=https://your-liverpool-service/api/generate
# LINKGEN_API_KEY_LIVERPOOL=replace-with-your-api-key

# Local-dev-only: hand out links from the `tickets` table (seeded by
# `flask seed-db`) instead of calling LINKGEN_API_URL. Skips password
# verification entirely - keep this false everywhere real users can reach
# the app.
ENABLE_MOCK_TICKET_LOOKUP=false

# --- Rate limiting ---
# Login/register/generate-link attempts are capped per IP (or per account
# for generate-link). In-memory by default; only needed if you run more
# than one gunicorn worker and want limits shared across all of them:
# RATELIMIT_STORAGE_URI=redis://localhost:6379
